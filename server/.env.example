# Environnement : development | production
NODE_ENV=development
PORT=3000

# Base de données
# Développement (SQLite) — le chemin est relatif au dossier prisma/
DATABASE_URL="file:./dev.db"
# Production (MySQL 8+, utf8mb4) : DATABASE_URL="mysql://user:motdepasse@hote:3306/logistictrack"

# Secrets : OBLIGATOIRES et différents en production (openssl rand -hex 48)
JWT_SECRET=change-me-dev-only
FILE_URL_SECRET=change-me-dev-only-too
JWT_ACCESS_TTL_SECONDS=900

# Origines Web autorisées (séparées par des virgules)
WEB_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000

# Stockage des fichiers privés (preuves, photos)
STORAGE_DIR=./storage

# Redis (facultatif en développement) : active l'adaptateur Socket.IO et BullMQ
# REDIS_URL=redis://localhost:6379

# Paiements : secret HMAC des webhooks par prestataire
PAYMENT_WEBHOOK_SECRET=change-me-dev-only-four

# Compte Super Administrateur créé par le seed
SUPERADMIN_EMAIL=admin@logistictrack.local
SUPERADMIN_PASSWORD=

# --- Envoi des e-mails (réinitialisation de mot de passe, e-mail de test) ---
# Se règle de préférence dans l'administration : Super Administrateur > Mon compte > Envoi des e-mails.
# Les valeurs ci-dessous ne servent que si rien n'y est enregistré.
# Gmail : activez la validation en deux étapes sur le compte Google, puis créez un
# « mot de passe d'application » (https://myaccount.google.com/apppasswords) et collez-le ci-dessous.
# N'utilisez jamais le mot de passe normal du compte Gmail.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="LogisticTrack <votre.adresse@gmail.com>"
# Adresse publique du site web, utilisée dans les liens envoyés par e-mail.
WEB_PUBLIC_URL=http://localhost:5174

# --- Sauvegardes (base + fichiers : preuves, photos, signatures, logos) ---
# Une sauvegarde automatique par jour, conservée BACKUP_KEEP_DAYS jours.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Seconde copie, sur un autre disque ou un dossier synchronisé (Google Drive, Dropbox, disque externe).
# Fortement recommandé : une sauvegarde sur le même disque ne protège pas d'une panne de ce disque.
BACKUP_COPY_DIR=
