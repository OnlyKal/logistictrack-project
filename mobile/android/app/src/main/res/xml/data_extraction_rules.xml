<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : ni sauvegarde dans le cloud, ni transfert vers un autre téléphone.
     La file d'opérations, les positions et les jetons de session restent propres à cet appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
